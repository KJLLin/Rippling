{
  // Worker 配置
  // 用法：npx wrangler deploy --config wrangler.worker.jsonc
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rippling",
  "main": "src/worker.ts",
  "compatibility_date": "2025-07-18",
  "compatibility_flags": ["nodejs_compat"],

  // 静态资源：public/ 就是 vite build 的输出目录
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },

  // D1 数据库
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rippling",
      "database_id": "603159d9-65f1-46fc-bcbc-4dadd6ef2f3d"
    }
  ],

  // 先用 workers.dev 地址，绑定自有域名后再加 routes
  "workers_dev": true,

  "observability": { "enabled": true }
}
